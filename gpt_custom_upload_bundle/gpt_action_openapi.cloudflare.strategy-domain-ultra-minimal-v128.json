{
  "openapi": "3.1.0",
  "info": {
    "title": "Quant BTC Strategy",
    "version": "1.28.1"
  },
  "servers": [
    {
      "url": "https://quant-btc-model-strategy.mdl-bitcoin-analyst.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "btcStrategyHealth",
        "summary": "Health check du Worker strategy.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "worker_version": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/strategies/status": {
      "get": {
        "operationId": "btcStrategyStatus",
        "summary": "Statut du moteur de strategies quantitatives.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "worker_version": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/strategies/deep-signal": {
      "get": {
        "operationId": "btcStrategyDeepSignal",
        "summary": "Score quantitatif strategy BTC en preset deep, horizon 30j.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "side": {
                      "type": "string"
                    },
                    "ensemble_score": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/strategies/deep-paper-order": {
      "get": {
        "operationId": "btcStrategyDeepPaperOrder",
        "summary": "Creer un ordre paper strategy en preset deep 30j si les gates passent.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "order_id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
