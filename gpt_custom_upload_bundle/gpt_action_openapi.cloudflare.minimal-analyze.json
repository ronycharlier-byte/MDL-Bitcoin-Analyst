                    },
                    "archive_id": {
                      "type": "string"
                    },
                    "report_date_utc": {
                      "type": "string"
                    },
                    "reference_spot": {
                      "type": "string"
                    },
                    "frames_count": {
                      "type": "integer"
                    },
                    "response_type": {
                      "type": "string"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
