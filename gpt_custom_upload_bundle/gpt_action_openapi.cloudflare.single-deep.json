{
  "openapi": "3.1.0",
  "info": {
    "title": "Quant BTC Model GPT single deep",
    "version": "1.15.6-single-deep",
    "description": "Single-run isolation schema for GPT Actions. BTC is implicit. Probabilistic outputs only."
  },
  "servers": [
    {
      "url": "https://quant-btc-model-lite.mdl-bitcoin-analyst.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthDeep",
        "summary": "Health check",
        "description": "Check Worker availability.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/run-deep": {
      "get": {
        "operationId": "runQuantBtcDeepOnly",
        "summary": "Run deep BTC preset",
        "description": "Run deep BTC preset",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BasicResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "archive_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "report_markdown": {
            "type": "string"
          }
        }
      }
    }
  }
}
