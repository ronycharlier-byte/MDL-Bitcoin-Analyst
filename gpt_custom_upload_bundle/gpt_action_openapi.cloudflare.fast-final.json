{
  "openapi": "3.1.0",
  "info": {
    "title": "Quant BTC Model GPT Fast Final Schema",
    "version": "1.19.1-fast-final-no-params",
    "description": "Stable GPT Action schema. No parameters. /analyze uses quick preset and recent cache by default to avoid long loading. Outputs are probabilistic only."
  },
  "servers": [
    {
      "url": "https://quant-btc-model-lite.mdl-bitcoin-analyst.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "btcFastHealth",
        "summary": "Health check",
        "description": "Check Quant BTC Worker availability.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "worker_version": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "timestamp_utc": {
                      "type": "string"
                    },
                    "timestamp_paris": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
