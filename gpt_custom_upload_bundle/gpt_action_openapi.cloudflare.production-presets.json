{
  "openapi": "3.1.0",
  "info": {
    "title": "Quant BTC Model GPT Production Schema",
    "version": "1.15.4-production-presets",
    "description": "Production GPT Actions schema for Quant BTC Model. Uses preset run endpoints only. BTC is implicit. Outputs are probabilistic scenarios, not deterministic predictions or financial advice."
  },
  "servers": [
    {
      "url": "https://quant-btc-model-lite.mdl-bitcoin-analyst.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health check",
        "description": "Check Worker availability.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getQuantBtcLiteVersion",
        "summary": "Get Worker version",
        "description": "Return Worker/schema/version metadata and preset information.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getQuantBtcLiteStatus",
        "summary": "Get runtime status",
        "description": "Return endpoints, runtime limits, source policy and limitations.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/audit": {
      "get": {
        "operationId": "auditQuantBtcLiteSystem",
        "summary": "Audit system readiness",
        "description": "Preflight governance audit before live BTC analysis.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/run-quick": {
      "get": {
        "operationId": "runQuantBtcQuick",
        "summary": "Run quick BTC preset",
        "description": "Quick BTC preset: 7, 30, 90, 180, 365 days with 2000 simulations per horizon.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/run-tactical": {
      "get": {
        "operationId": "runQuantBtcTactical",
        "summary": "Run tactical BTC preset",
        "description": "Tactical BTC preset: 1, 3, 7, 14, 30 days with 5000 simulations per horizon.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/run-deep": {
      "get": {
        "operationId": "runQuantBtcDeep",
        "summary": "Run deep BTC preset",
        "description": "Deep BTC preset: 1, 3, 7, 14, 30, 90, 180, 365 days with 10000 simulations per horizon.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/latest": {
      "get": {
        "operationId": "latestQuantBtcReport",
        "summary": "Get latest stored BTC report",
        "description": "Return the latest stored report artifact. This is not necessarily a fresh run.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/history": {
      "get": {
        "operationId": "getQuantBtcHistory",
        "summary": "Get stored BTC run history",
        "description": "Return recent archived run metadata.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/compare-runs": {
      "get": {
        "operationId": "compareQuantBtcRuns",
        "summary": "Compare recent BTC runs",
        "description": "Compare the latest run against the previous stored run when available.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "operationId": "getQuantBtcAlerts",
        "summary": "Get BTC alert status",
        "description": "Return current alert diagnostics when available.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/backtest-summary": {
      "get": {
        "operationId": "getQuantBtcBacktestSummary",
        "summary": "Get BTC backtest summary",
        "description": "Return visible backtest diagnostics when available.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BasicResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "archive_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "report_date_utc": {
            "type": "string"
          },
          "timestamp_utc": {
            "type": "string"
          },
          "timestamp_paris": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "warning": {
            "type": "string"
          },
          "report_markdown": {
            "type": "string"
          }
        }
      }
    }
  }
}
