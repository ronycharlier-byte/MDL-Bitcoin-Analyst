{
  "openapi": "3.1.0",
  "info": {
    "title": "Quant BTC Model GPT Tiny Smoke Schema",
    "version": "1.15.3-tiny-smoke",
    "description": "GPT Actions schema for Quant BTC Model. BTC is implicit. Outputs are probabilistic scenarios, not deterministic predictions or financial advice."
  },
  "servers": [
    {
      "url": "https://quant-btc-model-lite.mdl-bitcoin-analyst.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health check",
        "description": "Check Worker availability.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    },
    "/run-deep": {
      "get": {
        "operationId": "runQuantBtcDeep",
        "summary": "Run deep BTC preset",
        "description": "Deep BTC preset: 1, 3, 7, 14, 30, 90, 180, 365 days with 10000 simulations per horizon.",
        "responses": {
          "200": {
            "description": "Successful JSON response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BasicResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "archive_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "report_date_utc": {
            "type": "string"
          },
          "timestamp_utc": {
            "type": "string"
          },
          "timestamp_paris": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "warning": {
            "type": "string"
          },
          "report_markdown": {
            "type": "string"
          }
        }
      }
    }
  }
}
